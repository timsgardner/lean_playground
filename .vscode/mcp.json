{
  "servers": {
    "lean-lsp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "lean-lsp-mcp"
      ],
      "cwd": "/home/timsg/code/lean_playground"
    },
    "lean-explore": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "lean-explore",
        "lean-explore",
        "mcp",
        "serve",
        "--backend",
        "api"
      ],
      "cwd": "/home/timsg/code/lean_playground"
    },
    "tikz-cd": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--project",
        "/home/timsg/code/tikz-cd-mcp",
        "tikz-cd-mcp"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "/home/timsg/.local/texlive/2026/bin/x86_64-linux:/home/timsg/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
